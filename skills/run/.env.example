# Copy this file to .env and paste your real keys. Keep .env out of git.
# kie.ai is the only key you need to start. fal.ai and WaveSpeed are optional fallbacks.

KIE_API_KEY=your_kie_key_here

# Where generated files (mp4s, stills, sidecars, ledger.json) are saved.
# Leave blank to use the default ~/faceless/generations.
GENERATIONS_DIR=

# Required only if you use Seedance 2.5 (bytedance/seedance-2-5) — animate.sh
# has no built-in default rate for it and stops without this set.
SEEDANCE25_CPS=

# Optional fallbacks (not wired into any script yet — see Provider routing in SKILL.md)
FAL_KEY=your_fal_key_here
WAVESPEED_API_KEY=your_wavespeed_key_here
